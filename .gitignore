# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
MANIFEST

# --- Virtual environments ---
.venv/
venv/
env/
.env

# --- Testing & coverage ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- Type checking ---
.mypy_cache/

# --- Linting ---
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- AutoPipeAD runtime outputs ---
# (reports, saved configs, experiment results — not versioned by default)
outputs/
reports/
results/
configs/saved/

# --- Dataset folders (usually too large for git) ---
data/
datasets/*
!datasets/README.md

# --- Claude Code (contexto local, no versionado) ---
CLAUDE.md

# --- LaTeX build artifacts ---
# Recursivos: los patrones anteriores solo cubrian docs/ y dejaban pasar los
# artefactos de docs/Informe/.
**/*.aux
**/*.log
**/*.out
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
**/*.nav
**/*.snm
**/*.toc
**/*.lof
**/*.lot
**/*.bbl
**/*.bcf
**/*.blg
**/*.run.xml

# PDF de documentos que se recompilan a diario. Los PDF de entregables
# (anteproyecto, articulo) si se versionan.
docs/Agenda.pdf
docs/Informe/Plantilla_Informe_TFG.pdf
docs/experimentos/Preregistro.pdf
docs/experimentos/Preregistro-E2.pdf

# El reporte del LODO se versiona en HTML, que es la fuente que produce el
# generador; el PDF se deriva de él con wkhtmltopdf al regenerarlo.
docs/experimentos/reportes/*.pdf

# Los reportes del caso de imágenes embeben miniaturas de MVTec AD, cuya licencia
# prohíbe redistribuir las imágenes (véase datasets/README.md). Se regeneran en local.
docs/experimentos/reportes/imagenes/
# Los informes de avance se entregan en PDF, pero el PDF se regenera desde su
# .tex: lo que se versiona es la fuente.
docs/Avances/*.pdf

# Plantilla y lineamientos de los informes de avance: documento de trabajo
# local, derivado de los Lineamientos para los TFG del curso.
docs/Avances/AVANCE_QUINCENAL.md

# --- OS ---
.DS_Store
Thumbs.db

# --- IDEs ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Secrets / env files ---
.env
.env.*
!.env.example